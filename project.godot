config_version=5

[application]

config/name="House of Deceptions"
run/main_scene="uid://c07u7jeypcgmn"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="res://icon.svg"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="House of Deceptions"

[global_group]

